<odoo>
    <record id="view_res_users_role_form_menu" model="ir.ui.view">
        <field name="name">res.users.role.form.menu_access</field>
        <field name="model">res.users.role</field>
        <field name="inherit_id" ref="base_user_role.view_res_users_role_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_view_menus"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bars"
                >
                    <field name="menu_count" widget="statinfo" string="Menus" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
