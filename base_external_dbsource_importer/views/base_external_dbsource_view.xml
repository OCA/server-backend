<odoo>
    <record id="view_dbsource_form" model="ir.ui.view">
        <field name="name">External Dbsource Importer View</field>
        <field name="model">base.external.dbsource</field>
        <field name="inherit_id" ref="base_external_dbsource.view_dbsource_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                    <field
                        name="fields_to_update_ids"
                        context="{'default_db_source_id': id}"
                    >
                        <list editable="top">
                            <field name="model_id" />
                            <field
                                name="field_ids"
                                domain="[('model_id', '=', model_id)]"
                                widget="many2many_tags"
                            />
                        </list>
                    </field>
                </group>
                <group string="Options">
                    <field name="only_update" />
                    <field name="force_update" />
                    <div>Clear ormcache</div>
                    <button
                        name="action_clear_cache"
                        type="object"
                        string="Clear"
                        class="btn btn-warning"
                    />
                </group>
                <group string="Import records between dates if supported">
                    <field name="date_from" />
                    <field name="date_to" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
