<odoo>
    <record id="view_anonymize_field_list" model="ir.ui.view">
        <field name="model">anonymize.field</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="model_id" required="True" />
                <field name="model_name" column_invisible="True" />
                <field name="field_id" required="True" />
                <field name="field_name" column_invisible="True" />
                <field name="method" />
                <field name="domain" />
                <field name="options" />
                <field name="default_options" optional="hide" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="view_anonymize_field_search" model="ir.ui.view">
        <field name="model">anonymize.field</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_name" />
                <field name="field_name" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <filter
                    name="groupby_model"
                    string="Model"
                    context="{'group_by': 'model_name'}"
                />
            </search>
        </field>
    </record>

    <record id="action_anonymize_field" model="ir.actions.act_window">
        <field name="name">Field Definitions</field>
        <field name="res_model">anonymize.field</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_groupby_model': True}</field>
        <field name="domain">[('applicable', '=', True)]</field>
    </record>
</odoo>
