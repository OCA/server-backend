<!-- Definitions for fields of modules that are not installed are kept
     and simply not applicable. Recompute definitions (sequence 80-90) run
     after the values they are computed from. -->
<odoo noupdate="1">
    <!-- account -->
    <record
        id="anon_account_move__invoice_partner_display_name"
        model="anonymize.field"
    >
        <field name="sequence">90</field>
        <field name="model_name">account.move</field>
        <field name="field_name">invoice_partner_display_name</field>
        <field name="method">anonymize.method.recompute</field>
