        <field name="model_name">res.partner</field>
        <field name="field_name">name</field>
        <field name="method">anonymize.method.fictional.character</field>
        <field
            name="domain"
        >[('is_company', '=', False), ('id', 'not in', protected_partner_ids)]</field>
