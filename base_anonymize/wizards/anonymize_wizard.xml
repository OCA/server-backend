<data>
    <record id="view_anonymize_wizard_form" model="ir.ui.view">
        <field name="model">anonymize.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-danger" role="alert">
                    This will destroy your data! Be absolutely sure you're on a test database!
                </div>
                <footer>
                    <button
                        name="action_run"
                        type="object"
                        string="Anonymize data"
                        class="btn-primary"
                        confirm="Are you really, really sure?"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_anonymize_wizard" model="ir.actions.act_window">
        <field name="name">Run anonymization</field>
        <field name="res_model">anonymize.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</data>
