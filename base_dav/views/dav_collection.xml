<odoo>
    <record id="view_dav_collection_list" model="ir.ui.view">
        <field name="model">dav.collection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="dav_type" />
                <field name="model_id" />
                <field name="domain" />
            </list>
        </field>
    </record>
    <record id="view_dav_collection_form" model="ir.ui.view">
        <field name="model">dav.collection</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" />
                    <field name="dav_type" />
                    <field name="url" widget="url" invisible="not url" />
                </group>
                <group string="Access">
                    <field name="model_id" />
                    <field name="model_name" invisible="1" />
                    <field
                        name="domain"
                        widget="domain"
                        options="{'model': 'model_name'}"
                    />
                    <field name="field_uuid" domain="[('model_id', '=', model_id)]" />
                    <field name="rights" />
                    <field name="calendar_color" invisible="dav_type != 'calendar'" />
                </group>
                <group string="Additional field mapping">
                    <field name="field_mapping_ids" nolabel="1" />
                </group>
            </form>
        </field>
    </record>

    <record id="view_dav_collection_mapping_list" model="ir.ui.view">
        <field name="model">dav.collection.field_mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="field_id" />
                <field name="mapping_type" />
            </list>
        </field>
    </record>

    <record id="view_dav_collection_mapping_form" model="ir.ui.view">
        <field name="model">dav.collection.field_mapping</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="collection_id" invisible="1" />
                    <field name="model_id" invisible="1" />
                    <field name="name" />
                    <field name="mapping_type" />
                    <field name="field_id" domain="[('model_id', '=', model_id)]" />
                    <field name="import_code" invisible="mapping_type != 'code'" />
                    <field name="export_code" invisible="mapping_type != 'code'" />
                </group>
            </form>
        </field>
    </record>

    <record id="action_dav_collection" model="ir.actions.act_window">
        <field name="name">WebDAV collections</field>
        <field name="res_model">dav.collection</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_dav_collection"
        name="WebDAV collections"
        parent="base.menu_administration"
        action="action_dav_collection"
        sequence="100"
    />
</odoo>
