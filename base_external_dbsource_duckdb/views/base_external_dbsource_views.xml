<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="view_dbsource_form">
        <field name="name">base.external.dbsource.duckdb.form</field>
        <field name="model">base.external.dbsource</field>
        <field name="inherit_id" ref="base_external_dbsource.view_dbsource_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='conn_string']/.." position="after">
                <group string="DuckDB configuration" invisible="connector != 'duckdb'">
                    <field name="readonly" />
                    <field name="config_display" widget="ace" readonly="0" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
