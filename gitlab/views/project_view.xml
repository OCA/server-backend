<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_form" model="ir.ui.view">
        <field name="model">gitlab.project</field>
        <field name="arch" type="xml">
            <form string="Gitlab Project">
                <header>
                    <button
                        name="import_commits"
                        string="Import Commits"
                        type="object"
                    />
                    <button name="import_issues" string="Import Issues" type="object" />
                    <button
                        name="import_merge_requests"
                        string="Import Merge Requests"
                        type="object"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="gitlab_id" />
                        <field name="group_id" />
                        <field name="url" widget="url" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_list" model="ir.ui.view">
        <field name="model">gitlab.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="group_id" />
                <field name="gitlab_id" />
            </list>
        </field>
    </record>

    <record id="project_action" model="ir.actions.act_window">
        <field name="name">Gitlab Projects</field>
        <field name="res_model">gitlab.project</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
