<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="merge_request_approval_form" model="ir.ui.view">
        <field name="model">gitlab.merge.request.approval</field>
        <field name="arch" type="xml">
            <form string="Gitlab Merge Request Approval">
                <sheet>
                    <group>
                        <field name="merge_request_id" />
                        <field name="approver_username" />
                        <field name="approved_at" />
                        <field name="partner_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="merge_request_approval_list" model="ir.ui.view">
        <field name="model">gitlab.merge.request.approval</field>
        <field name="arch" type="xml">
            <list>
                <field name="merge_request_id" />
                <field name="approver_username" />
                <field name="approved_at" />
                <field name="partner_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="merge_request_approval_action" model="ir.actions.act_window">
        <field name="name">Gitlab Merge Request Approvals</field>
        <field name="res_model">gitlab.merge.request.approval</field>
        <field name="view_mode">list,form</field>
    </record>

    <record
        id="merge_request_approval_reconcile_partner_action"
        model="ir.actions.server"
    >
        <field name="name">Reconcile Partners</field>
        <field name="model_id" ref="model_gitlab_merge_request_approval" />
        <field name="binding_model_id" ref="model_gitlab_merge_request_approval" />
        <field name="state">code</field>
        <field name="code">
            records.reconcile_partner()
        </field>
    </record>
</odoo>
