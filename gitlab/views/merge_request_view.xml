<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="merge_request_form" model="ir.ui.view">
        <field name="model">gitlab.merge.request</field>
        <field name="arch" type="xml">
            <form string="Gitlab Merge Request">
                <header>
                    <button name="import_notes" type="object" string="Import Notes" />
                    <button
                        name="import_approvals"
                        type="object"
                        string="Import Approvals"
                    />
                    <field
                        name="state"
                        readonly="1"
                        widget="statusbar"
                        statusbar_visible="opened,closed,merged,locked"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="author_username" />
                        <field name="url" widget="url" />
                        <field name="created_at" />
                        <field name="project_id" />
                        <field name="partner_id" />
                        <field name="note_ids" />
                        <field name="approval_ids">
                            <list>
                                <field name="approver_username" />
                                <field name="approved_at" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="merge_request_list" model="ir.ui.view">
        <field name="model">gitlab.merge.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="author_username" />
                <field name="url" widget="url" />
                <field name="created_at" />
                <field name="project_id" />
                <field name="partner_id" optional="hide" />
                <field name="throughtput_time" optional="hide" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="merge_request_search" model="ir.ui.view">
        <field name="model">gitlab.merge.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="state" />
                <field name="project_id" />
                <field name="partner_id" />
                <separator />
                <filter
                    name="last_30_days"
                    string="Last 30 days"
                    domain="[('created_at', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="last_year"
                    string="Last year"
                    domain="[('created_at', '&gt;=', (context_today() - datetime.timedelta(days=365)).strftime('%Y-%m-%d'))]"
                />

                <group string="Group By">
                    <filter
                        string="Project"
                        name="groupby_project_id"
                        domain="[]"
                        help="Project"
                        context="{'group_by':'project_id'}"
                    />
                    <filter
                        string="State"
                        name="groupby_state"
                        domain="[]"
                        help="State"
                        context="{'group_by':'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="merge_request_action" model="ir.actions.act_window">
        <field name="name">Gitlab Merge Requests</field>
        <field name="res_model">gitlab.merge.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="merge_request_reconcile_partner_action" model="ir.actions.server">
        <field name="name">Reconcile Partners</field>
        <field name="model_id" ref="model_gitlab_merge_request" />
        <field name="binding_model_id" ref="model_gitlab_merge_request" />
        <field name="state">code</field>
        <field name="code">
            records.reconcile_partner()
        </field>
    </record>
</odoo>
