<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="note_form" model="ir.ui.view">
        <field name="model">gitlab.note</field>
        <field name="arch" type="xml">
            <form string="Gitlab Note">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="author_username" />
                        <field name="created_at" />
                        <field name="project_id" />
                        <field name="url" widget="url" />
                        <field name="partner_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="note_list" model="ir.ui.view">
        <field name="model">gitlab.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="author_username" />
                <field name="created_at" />
                <field name="project_id" />
                <field name="url" widget="url" />
                <field name="partner_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="note_action" model="ir.actions.act_window">
        <field name="name">Gitlab Notes</field>
        <field name="res_model">gitlab.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="note_reconcile_partner_action" model="ir.actions.server">
        <field name="name">Reconcile Partners</field>
        <field name="model_id" ref="model_gitlab_note" />
        <field name="binding_model_id" ref="model_gitlab_note" />
        <field name="state">code</field>
        <field name="code">
            records.reconcile_partner()
        </field>
    </record>
</odoo>
