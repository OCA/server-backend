<odoo>
    <record id="view_email_server_form" model="ir.ui.view">
        <field name="inherit_id" ref="mail.view_email_server_form" />
        <field name="model">fetchmail.server</field>
        <field name="arch" type="xml">
            <field name="server" position="attributes">
                <attribute
                    name="required"
                    add="and server_type != 'local_mailbox'"
                    separator=" "
                />
            </field>
            <field name="user" position="attributes">
                <attribute
                    name="required"
                    add="and server_type != 'local_mailbox'"
                    separator=" "
                />
            </field>
            <page name="server_login_details" position="attributes">
                <attribute name="invisible">server_type == 'local_mailbox'</attribute>
            </page>
            <page name="server_login_details" position="after">
                <page
                    string="Mailbox"
                    name="local_mailbox"
                    invisible="server_type != 'local_mailbox'"
                >
                    <group>
                        <field
                            name="mailbox_path"
                            required="server_type == 'local_mailbox'"
                            readonly="state != 'draft'"
                        />
                        <field
                            name="mailbox_type"
                            required="server_type == 'local_mailbox'"
                            readonly="state != 'draft'"
                        />
                        <field name="mailbox_delete_processed" />
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
